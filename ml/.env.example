# Copy to ml/.env. Never commit real keys.

# development, test or production. Demo logins are never created in production.
APP_ENV=development

# mongodb (default) or json (offline demo and tests)
DATA_STORE=mongodb
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=devbridge

# Long random value used to sign login tokens. Required in production.
AUTH_SECRET=
AUTH_TOKEN_HOURS=12
DEMO_ACCOUNT_PASSWORD=DevBridge@2026

AI_PROVIDER_MODE=local
MODEL_PATH="H:\\WHATEVER_YOUR_DRIVE_NAME\\Dev_Bridge\\models\\paraphrase-MiniLM-L6-v2"

# Cloudflare Workers AI (Workers Free plan only)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b

# OpenRouter (free models only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# cloud or disabled
AI_PROVIDER_MODE=cloud
AI_REQUEST_TIMEOUT=60
SRS_REQUEST_TIMEOUT=150
SRS_MAX_OUTPUT_TOKENS=6000
SRS_TEMPERATURE=0.2

# Local daily budgets, kept below the free limits
CLOUDFLARE_DAILY_NEURON_BUDGET=9000
OPENROUTER_DAILY_REQUEST_BUDGET=45
OPENROUTER_FREE_CHECK_TTL=3600

# Duplicate matching
MATCH_MIN_SIMILARITY=0.60
MATCH_MIN_KEYWORD_OVERLAP=0.12
MATCH_TOP_K=3
MATCH_CANDIDATE_POOL=200
MATCH_SESSION_TTL_HOURS=24
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_CHARS=6000

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173