<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center" android:orientation="vertical">
    <TextView android:id="@+id/logo" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="DevBridge" android:textSize="42sp" android:textStyle="bold"
        android:textColor="?attr/colorPrimary"/>
    <TextView android:id="@+id/tag" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Bridging users and developers"/>
</LinearLayout>